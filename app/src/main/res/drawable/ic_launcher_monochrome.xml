<?xml version="1.0" encoding="utf-8"?>
<!-- Themed-icon layer (Android 13+): the capsule and clock as flat shapes, kept apart so they read at small sizes;
     the launcher tints it. Everything sits inside the 66dp safe circle. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">
    <!-- Capsule, tilted 45°: solid lower half, lighter upper half. -->
    <group android:rotation="-45" android:pivotX="48" android:pivotY="50">
        <path android:fillColor="#FFFFFFFF"
            android:pathData="M48,41 h-11 a9,9 0 0 0 0,18 h11 z" />
        <path android:fillColor="#FFFFFFFF" android:fillAlpha="0.6"
            android:pathData="M48,41 h11 a9,9 0 0 1 0,18 h-11 z" />
    </group>
    <!-- Clock badge, lower right: a ring with hands. -->
    <path android:fillColor="#FFFFFFFF" android:fillType="evenOdd"
        android:pathData="M65,56 a11,11 0 1 1 0,22 a11,11 0 1 1 0,-22 z M65,59.5 a7.5,7.5 0 1 0 0,15 a7.5,7.5 0 1 0 0,-15 z" />
    <path android:fillColor="#FFFFFFFF"
        android:pathData="M63.6,61.5 h2.8 v5.6 h4 v2.8 h-6.8 z" />
</vector>
